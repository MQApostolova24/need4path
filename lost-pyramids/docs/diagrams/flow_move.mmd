flowchart LR
  subgraph S1 [1. Can the explorer move?]
    direction TB
    A([Arrow key pressed]) --> B{Inside the pyramid<br/>and not a wall?}
    B -->|no| X([Stay in place])
    B -->|yes| C{Secret door?}
    C -->|yes| D{Has a key?}
    D -->|no| X
    D -->|yes| E[Use the key,<br/>open the door]
    C -->|no| F
    E --> F[Move one tile]
  end
  subgraph S2 [2. What happens on the new tile]
    direction TB
    G[Pick up the item:<br/>key, treasure, gem,<br/>relic, time bonus] --> H{Trap or<br/>guardian?}
    H -->|yes| I[Lose a life] --> J{Lives left?}
    J -->|no| L([Game lost])
    J -->|yes| K
    H -->|no| K{Exit gate?}
    K -->|yes| W([Game won])
    K -->|no| O([Wait for the next key])
  end
  F --> G
